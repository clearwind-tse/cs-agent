# ==========================================================================
# Agent CS Playbook — 环境变量模板
#
# 模型配置分两层，别混在一起：
#   1) API Key / base_url / provider 默认模型名 → 只在这份 .env 里配（下面这一节）。
#      设置页不会保存、也不会回显密钥；多实例部署靠同一份环境变量保持一致。
#   2) 「哪个业务板块用哪个 provider / 哪个模型」→ 前端「设置 → 模型信息」里配，
#      存 model_settings 表，保存后即时生效、不用重启；没配的板块用代码默认值。
#      代码默认值在 backend/app/services/model_registry.py 的 SLOTS / PROVIDERS。
#
# auto 模式的默认优先级刻意沿用改造前各服务自己的顺序：
#   多数板块 DeepSeek → OpenAI；知识问答 / 知识抽取 Ark → DeepSeek → OpenAI。
#   想换就在设置页显式选，不用改代码。
# ==========================================================================

# Database (docker compose -f docker-compose.db.yml up -d)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/agent_cs_playbook

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- OpenAI 兼容端点 ----------
# BASE_URL 指向本地 Ollama / vLLM / 任意 OpenAI 兼容服务，即可在设置页把板块切到自托管模型
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 阿里云百炼 / DashScope（对话 + Embedding 共用 Key） ----------
ARK_API_KEY=${ARK_API_KEY}
ARK_EMBEDDING_MODEL=text-embedding-v3
ARK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 注意：换 Embedding 模型会改变向量维度，需要重建 knowledge_chunks / knowledge_articles 的向量列

# ---------- 火山方舟视觉理解 ----------
# 视觉模型名通常是 ep-xxxx 形式的「推理接入点 ID」，每个人都不一样：
# 必须把 ARK_VISION_MODEL 换成自己账号下的端点 ID，或在设置页的「图片信息提取」板块覆盖。
ARK_VISION_API_KEY=${ARK_VISION_API_KEY}
ARK_VISION_MODEL=ep-your-endpoint-id
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# WeChat Database Path
WECHAT_DB_PATH=../Msg/Msg

# WeChat Voice File Path
VOICE_FILE_PATH=../FileStorage/Voice

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
APP_ENV=dev

# Volcengine TOS (Object Storage) — 当前未使用，素材先落本地磁盘
TOS_ACCESS_KEY=${TOS_ACCESS_KEY}
TOS_SECRET_KEY=${TOS_SECRET_KEY}
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=wx-bucket

# ---------- AI 创作 · 媒体存储 ----------
# 默认落本地磁盘 backend/data/media；留空即用默认路径。
# 换 OSS / TOS 时只需替换 app/services/media_store.py，表结构与前端契约不变。
MEDIA_ROOT=
MEDIA_MAX_MB=20
